# ============================================================
# PLANTILLA DE CONFIGURACIÓN POR CLIENTE (copiar a .env)
#   cp .env.example .env   → editar TODOS los valores
# El .env NUNCA se versiona (está en .gitignore).
# ============================================================

# --- Django ---
# Generar con: python3 scripts/gen_secret_key.py  (SIN comillas)
SECRET_KEY=
# False en producción (activa S3 para estáticos). True solo en desarrollo local.
DEBUG=False

# --- Dominio del cliente ---
# Solo host, sin https:// ni barra final:
ALLOWED_HOSTS=micliente.vadomconsultas.com,localhost,127.0.0.1
# Con https://, sin barra final:
CSRF_TRUSTED_ORIGINS=https://micliente.vadomconsultas.com
MI_DOMINIO=https://micliente.vadomconsultas.com

# --- Base de datos PostgreSQL (RDS) ---
# La crea el proveedor de despliegues; pegar aquí las credenciales que entreguen.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=vadom-consulting-db.cotou8cmuagz.us-east-1.rds.amazonaws.com
DB_PORT=5432

# --- API ConsultaListasPeps ---
API_TOKEN=8495-4545-4487
API_BASE_URL=https://www.consultalistaspeps.com/ClientArea/BLS_WS_BLS/ConsultaListasPeps.svc/rest/

# --- AWS S3 ---
# Carpeta del cliente dentro del bucket vadomdata (ej: comertex, redpapaz, compas).
# La autenticación AWS es por IAM Role del EC2: NO se ponen llaves aquí.
S3_CLIENT_PREFIX=micliente

# --- Email SMTP (notificaciones de cargas masivas y hallazgos) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
ADMIN_EMAIL=

# --- Features por cliente ---
# Email a los superiores de la empresa cuando una búsqueda tiene hallazgos.
NOTIFICAR_HALLAZGOS=True
